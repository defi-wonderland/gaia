# Hermes Pipeline — Environment Variables
# Copy to .env and fill in values.

# === Data Source ===
#
# Two data sources are supported:
#   1. Amp Flight SQL  — set AMP_FLIGHT_URL to enable
#   2. Substreams gRPC — used when AMP_FLIGHT_URL is NOT set
#
# When AMP_FLIGHT_URL is set, Substreams env vars are ignored.

# Use mock stream instead of live data (set to "true" or "1")
# USE_MOCK=true

# --- Amp Flight SQL (preferred) ---

# Amp Flight SQL endpoint URL (setting this enables Amp mode)
# AMP_FLIGHT_URL=http://localhost:1602

# Amp dataset name
# AMP_DATASET=geo/actions

# Block number to start from (default: 82655)
# AMP_START_BLOCK=82655

# Block number to stop at (default: continuous)
# AMP_END_BLOCK=

# Space Registry contract address (default: 0xb01683b2f0d38d43fcd4d9aab980166988924132)
# AMP_ACTIONS_ADDRESS=

# Delay in seconds before reconnecting on stream end/error (default: 2)
# AMP_RECONNECT_DELAY_SECS=2

# --- Substreams gRPC (legacy) ---

# Substreams gRPC endpoint URL
# SUBSTREAMS_ENDPOINT=https://geotest.substreams.pinax.network:443

# Auth token for substreams endpoint (read by hermes-relay)
# SUBSTREAMS_API_TOKEN=

# Block number to start from
# SUBSTREAMS_START_BLOCK=82655

# Block number to stop at (default: continuous)
# SUBSTREAMS_END_BLOCK=

# === Database ===

# PostgreSQL connection string (required when USE_MOCK is not true, for IPFS cache)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# === Kafka ===

# Kafka broker address
KAFKA_BROKER=localhost:9092

# Producer delivery timeout in ms (default: 30000)
# KAFKA_MESSAGE_TIMEOUT_MS=30000

# Send queue timeout in ms (defaults to KAFKA_MESSAGE_TIMEOUT_MS)
# KAFKA_SEND_TIMEOUT_MS=

# === Topic Routing ===

# Environment for Kafka topic prefix (required in production; read by hermes-kafka)
# Must be "staging" or "production"
# ENVIRONMENT=staging

# === Logging ===

# Emit per-event event-id logs (off by default)
# LOG_EVENT_IDS=true

# === Telemetry (optional) ===

# Sentry DSN (enables Sentry when set)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_SEND_DEFAULT_PII=false
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# SENTRY_DEBUG=false
